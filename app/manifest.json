{
  "manifest_version": 3,
  "name": "CheckRow",
  "short_name": "CheckRow",
  "version": "0.6.3",
  "description": "A clean to-do list in your browser's side panel: lists, due dates, priorities, a daily reminder and AI morning briefs.",
  "icons": {
    "16": "icons/checkrow-16.png",
    "32": "icons/checkrow-32.png",
    "48": "icons/checkrow-48.png",
    "128": "icons/checkrow-128.png"
  },
  "action": {
    "default_title": "Open CheckRow",
    "default_icon": {
      "16": "icons/checkrow-16.png",
      "32": "icons/checkrow-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel", "storage", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  }
}
